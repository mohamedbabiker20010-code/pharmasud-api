# PharmaSUD - Environment Configuration Example
# انسخ هذا الملف إلى .env وعدّل القيم

# قاعدة البيانات - PostgreSQL
# لـ Render.com: Dashboard > Environment Variables > DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# مفتاح التوقيع - غيّره بقوة!
# شغّل: openssl rand -hex 32
# يجب أن يكون 32 حرف هكسادسيمال على الأقل (64 حرف موصى به)
SECRET_KEY=<GENERATE_A_FIXED_RANDOM_SECRET>

# الإعدادات
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# البيئة
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS (استخدم عنوان URL المحدد في الإنتاج)
ALLOWED_ORIGINS=*

# Private platform-operator access (store the bcrypt hash as a managed secret)
PLATFORM_OPERATOR_USERNAME=operator@example.com
PLATFORM_OPERATOR_PASSWORD_HASH=<BCRYPT_HASH>

# Transactional email transport
APP_BASE_URL=https://app.example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<SMTP_USERNAME>
MAIL_PASSWORD=<SMTP_PASSWORD>
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=PharmaSUD
